<?xml version="1.0" encoding="UTF-8"?> <persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_2.xsd" version="2.2">
             
		<persistence-unit name="Remedio">
				<class>br.edu.ifpr.OfflineApp.model.Cidade</class>
				<class>br.edu.ifpr.OfflineApp.model.Empresa</class>
				<class>br.edu.ifpr.OfflineApp.model.Remedio</class>
				<class>br.edu.ifpr.OfflineApp.model.Usuario</class>
				<class>br.edu.ifpr.OfflineApp.model.Substancia</class>
				<class>br.edu.ifpr.OfflineApp.model.Prescricao</class>
				<class>br.edu.ifpr.OfflineApp.model.Tarja</class>
				<class>br.edu.ifpr.OfflineApp.model.RemediosPublicoAlvo</class>
				<class>br.edu.ifpr.OfflineApp.model.PublicoAlvo</class>
				<properties>
						<property name="jakarta.persistence.jdbc.driver" value="com.mysql.jdbc.Driver"/>
						<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/offlineapp_db"/>
						<property name="jakarta.persistence.jdbc.user" value="appuser"/>
						<property name="jakarta.persistence.jdbc.password" value="1234"/>
						<property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
						<property name="hibernate.hbm2ddl.auto" value="update"/>
				</properties>
		</persistence-unit>
</persistence>